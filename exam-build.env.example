# Copy to exam-build.env (gitignored) and set real values. If --build-arg-file rejects
# comments, keep only the two KEY=value lines in exam-build.env.
#
# Build (from repo root):
#   sudo podman build -t project100-exam:latest -f containerfile . \
#     --cap-add=all --security-opt=label=type:container_runtime_t --device /dev/fuse \
#     --build-arg-file=exam-build.env
#
# Fallback if --build-arg-file is unsupported:
#   set -a && source exam-build.env && set +a
#   sudo podman build ... --build-arg "BOT_TOKEN=${BOT_TOKEN}" --build-arg "CHAT_ID=${CHAT_ID}"

BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
CHAT_ID=YOUR_TELEGRAM_CHAT_ID
